# Cle personnelle de l'API Garmin Connect.
#
# A creer sur https://connect.garmin.com/app/settings/personalApiToken
# Elle n'est affichee qu'une seule fois, et expire au bout de 30, 90, 180
# jours ou un an selon le choix fait a la creation. Il n'y en a qu'une active
# par compte.
#
# Optionnelle : sans elle, l'import de fichiers FIT fonctionne normalement.
GARMIN_API_KEY=

# Port du conteneur Postgres. Defaut 5436.
POSTGRES_PORT=5436
